rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function jeAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function jeFakultet(fakultetId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'fakultet'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fakultetId == fakultetId;
    }

    // svatko svoj profil, admin dodjeljuje uloge ali samo tudjima (inace bi si svatko dao admina)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || jeAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if (jeAdmin() && request.auth.uid != uid)
        || (request.auth != null
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // cita svatko, pise predstavnik svog fakulteta, admin samo brise (moderacija)
    match /obavijesti/{id} {
      allow read: if true;
      allow create: if jeFakultet(request.resource.data.fakultetId);
      allow update: if jeFakultet(resource.data.fakultetId);
      allow delete: if jeFakultet(resource.data.fakultetId) || jeAdmin();
    }

    // cita svatko, unosi samo predstavnik svog fakulteta
    match /upisi/{id} {
      allow read: if true;
      allow create: if jeFakultet(request.resource.data.fakultetId);
      allow update: if jeFakultet(resource.data.fakultetId);
      allow delete: if jeFakultet(resource.data.fakultetId);
    }

    // postavlja prijavljeni u svoje ime, brise autor/predstavnik/admin (s pitanjem idu i odgovori)
    match /pitanja/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid)
        || jeFakultet(resource.data.fakultetId)
        || jeAdmin();
    }

    // odgovara svaki prijavljeni, sluzbeni odgovor smije oznaciti samo pravi predstavnik
    match /odgovori/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.sluzbeni == false || jeFakultet(request.resource.data.fakultetId));
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid)
        || (request.auth != null && resource.data.pitanjeUid == request.auth.uid)
        || jeFakultet(resource.data.fakultetId)
        || jeAdmin();
    }
  }
}
